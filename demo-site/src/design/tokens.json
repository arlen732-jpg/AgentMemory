{
  "meta": {
    "project": "AgentMemory 個人記憶庫",
    "preset": "現代清爽",
    "author": "Arlen",
    "version": "1.0",
    "updated_at": "2026-11-12",
    "density": "適中",
    "radiusStyle": "圓潤",
    "colorMode": "明亮優先",
    "darkMode": "none",
    "elevationStyle": "柔和懸浮",
    "motionStyle": "流暢自然",
    "fontStyle": "現代無襯線",
    "layoutStyle": "側邊導航（手機漢堡選單）",
    "a11yLevel": "WCAG AA",
    "imageryStyle": "線條手繪",
    "chartPalette": "品牌延伸",
    "iconStyle": "線性 outline"
  },
  "color": {
    "_note": "primary.DEFAULT 為 Arlen 指定的鼠尾草綠，只用於填色（按鈕底、選中態、圖表線）。放在背景上當文字時對比僅 4.43，所以文字一律改用 primary.text",
    "primary":   { "DEFAULT": "#4D7C6B", "hover": "#3F6A5B", "active": "#335649", "subtle": "#E8F0EC", "text": "#3F6A5B" },
    "secondary": { "DEFAULT": "#E07A5F", "hover": "#D2694D", "subtle": "#FBEDE8", "text": "#A84D35", "onSecondary": "#1C1C18",
                   "_note": "珊瑚橘 DEFAULT 對白底僅 2.95，只作裝飾點綴；放文字用 secondary.text；珊瑚底上的文字用深色 onSecondary" },
    "semantic": {
      "success": "#2A7040",
      "warning": "#96500A",
      "danger":  "#B42318",
      "info":    "#2E6A8A",
      "successSubtle": "#E6F2E9",
      "warningSubtle": "#FBF0E1",
      "dangerSubtle":  "#FCE9E7",
      "infoSubtle":    "#E5F0F5"
    },
    "neutral": {
      "50":  "#FAFAF7",
      "100": "#F2F2EC",
      "200": "#E4E4DC",
      "300": "#D0D0C6",
      "400": "#A3A396",
      "500": "#6B6B60",
      "600": "#57574D",
      "700": "#42423A",
      "800": "#2B2B25",
      "900": "#1C1C18"
    },
    "background": {
      "page":    "#F7F7F2",
      "surface": "#FFFFFF",
      "muted":   "#EFEFE8"
    },
    "text": {
      "primary":   "#1C1C18",
      "secondary": "#57574D",
      "muted":     "#6B6B60",
      "onPrimary": "#FFFFFF"
    },
    "chart": {
      "_note": "對應 D12 品牌延伸。血壓趨勢三條線：收縮壓 / 舒張壓 / 脈搏。系統不做偏高判讀，所以不使用紅綠語意色",
      "strategy": "brand",
      "categorical": ["#4D7C6B", "#D2694D", "#5B6FA0", "#A3A396"],
      "series": { "systolic": "#4D7C6B", "diastolic": "#D2694D", "pulse": "#5B6FA0" },
      "sequential": ["#E8F0EC", "#B9D1C6", "#86AE9E", "#4D7C6B", "#335649"],
      "gridline": "#E4E4DC",
      "axisLabel": "#6B6B60"
    }
  },
  "a11y": {
    "contrastTarget": "AA",
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "checked": true,
    "_checkedNote": "2026-11-12 以 WCAG 相對亮度公式實算。調整項：主色文字改用 primary.text #3F6A5B（5.71）；珊瑚橘文字改用 secondary.text #A84D35（5.17）；語意色全部加深到 ≥4.5（含 muted 背景）；舒張壓線改 #D2694D（對白 3.58，圖形 ≥3）",
    "focusVisible": "2px solid primary + 2px offset，鍵盤操作必顯示",
    "minTouchTarget": "44x44px"
  },
  "imagery": {
    "style": "hand-drawn line art",
    "promptPhrase": "hand-drawn line art, monoline sketch style, warm and calm, sage green (#4D7C6B) lines with soft coral (#E07A5F) accents on off-white (#F7F7F2)",
    "constraints": "no text, no logo, transparent or solid off-white background"
  },
  "iconography": {
    "style": "outline",
    "set": "lucide",
    "strokeWidth": 1.75,
    "sizes": { "sm": "16px", "md": "20px", "lg": "24px" }
  },
  "typography": {
    "fontFamily": "'Noto Sans TC', 'Inter', system-ui, -apple-system, sans-serif",
    "numericFontFeature": "tabular-nums",
    "scale": {
      "display": { "size": "2rem",     "weight": 700, "lineHeight": 1.2 },
      "h1":      { "size": "1.5rem",   "weight": 700, "lineHeight": 1.3 },
      "h2":      { "size": "1.25rem",  "weight": 600, "lineHeight": 1.4 },
      "h3":      { "size": "1.125rem", "weight": 600, "lineHeight": 1.4 },
      "body":    { "size": "1rem",     "weight": 400, "lineHeight": 1.6 },
      "small":   { "size": "0.875rem", "weight": 400, "lineHeight": 1.5 },
      "caption": { "size": "0.75rem",  "weight": 400, "lineHeight": 1.5, "color": "text.muted" }
    }
  },
  "spacing": {
    "base": 8,
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96],
    "cardPadding": 20,
    "sectionGap": 24
  },
  "radius": {
    "strategy": "round",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "full": "9999px"
  },
  "elevation": {
    "strategy": "shadow",
    "shadow": {
      "sm": "0 1px 2px rgba(28,28,24,.05)",
      "md": "0 4px 14px rgba(28,28,24,.07)",
      "lg": "0 12px 32px rgba(28,28,24,.10)"
    }
  },
  "motion": {
    "transition": "all .18s ease",
    "hover": "輕微上浮 translateY(-1px) + 陰影加深至 md",
    "focus": "2px ring primary，offset 2px",
    "duration": { "fast": "120ms", "base": "180ms", "slow": "300ms" }
  },
  "states": {
    "empty":   "線條手繪插圖(empty-state) + 主訴求文案 + 主要 CTA，禁止純空白",
    "loading": "skeleton 骨架屏，禁止只用單一 spinner 撐版面",
    "error":   "語意紅 icon + 失敗原因 + 重試按鈕"
  },
  "darkMode": {
    "_note": "D5 選明亮優先，不提供深色模式",
    "default": "light",
    "toggle": "none"
  }
}

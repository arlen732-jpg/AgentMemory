# 2026/11/12 - Arlen - 環境變數範本；實際值放 .env.local（不進版控）與 Vercel

# Neon Postgres（本機用 dev branch）
DATABASE_URL=

# Auth.js（npx auth secret 產生）
AUTH_SECRET=
# LINE Login channel；callback：http://localhost:3000/api/auth/callback/line
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# 唯一允許登入的 LINE 帳號代號（第一次登入被拒後，從 login_logs 查）
ALLOWED_LINE_USER_ID=

# 備註加密金鑰：32 bytes 的 Base64；遺失就解不開，請另外備份
NOTE_ENC_KEY=

# 系統參數（FSD §4.2，可不填，用預設值）
TOKEN_DEFAULT_DAYS=90
TOKEN_MAX_DAYS=365
WEB_SESSION_HOURS=12
